# ─────────────────────────────────────────────────────────────────────────────
# CISSOU configuration.  Copy to `.env` and fill in your own keys.
#
#   cp .env.example .env
#
# ─────────────────────────────────────────────────────────────────────────────

# --- Google Gemini (primary provider) ----------------------------------------
# Create keys at https://aistudio.google.com/apikey
# Add as many as you like: the app pools them and rotates on quota errors.
GOOGLE_GEMINI_API_KEY=
GOOGLE_GEMINI_API_KEY_2=
GOOGLE_GEMINI_API_KEY_3=
GOOGLE_GEMINI_API_KEY_4=
GOOGLE_GEMINI_API_KEY_5=
GEMINI_MODEL=gemini-3.5-flash

# --- Groq (failover provider, optional but recommended) ----------------------
# Free keys at https://console.groq.com/keys
# Keeps CISSOU answering when every Gemini key is rate-limited.
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_MODEL=qwen/qwen3.8-27b
# Groq's free tier allows 1000 output tokens per minute. Asking for more gets
# the request rejected outright, so keep this under that limit.
GROQ_MAX_OUTPUT_TOKENS=900

# Order providers are tried in.
PROVIDER_ORDER=gemini,groq

# --- Retrieval ---------------------------------------------------------------
RETRIEVAL_TOP_K=10          # knowledge sections injected per question
MAX_CONTEXT_CHARS=24000     # hard cap on retrieved context
BM25_TOP_K=10               # BM25 candidates considered before fusion
VECTOR_TOP_K=10             # semantic candidates considered before fusion
# Local semantic retrieval (fastembed, no API cost). Leave on for production;
# CI/tests force this off automatically so the test suite stays network-free.
ENABLE_SEMANTIC_RETRIEVAL=true
# Multi-document knowledge base: data/documents/<category>/*.md. Falls back
# to KNOWLEDGE_PATH below automatically if this directory is empty/missing.
KNOWLEDGE_DIR=data/documents

# --- Generation --------------------------------------------------------------
TEMPERATURE=0.3
MAX_OUTPUT_TOKENS=1400
REQUEST_TIMEOUT=30           # seconds for a single provider call
MAX_ATTEMPTS_PER_REQUEST=4   # keys one request may try before falling back
ANSWER_DEADLINE=45           # seconds before a request stops trying new keys

# --- Sessions & limits -------------------------------------------------------
SESSION_TTL_SECONDS=3600
MAX_HISTORY_TURNS=8
MAX_MESSAGE_CHARS=2000
RATE_LIMIT_PER_MINUTE=20

# --- Server ------------------------------------------------------------------
PORT=5000
LOG_LEVEL=INFO
# Comma-separated origins allowed to call /api/*. Restrict this in production.
CORS_ORIGINS=*
